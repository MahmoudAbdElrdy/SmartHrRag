{
  "ConnectionStrings": {
    "SqlServer": "Server=.;Database=SmartHrRag;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=True"
  },
  "Seed": {
    "Enabled": true
  },
  "Cors": {
    "Origins": [ "http://localhost:4200" ]
  },
  "Ollama": {
    "BaseUrl": "http://localhost:11434",
    "EmbedModel": "bge-m3",
    "ChatModel": "llama3.2:3b",
