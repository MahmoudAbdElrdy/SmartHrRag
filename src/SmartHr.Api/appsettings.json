    "RrfK": 60,
    "CandidatePool": 20,
    "Bm25K1": 1.2,
    "Bm25B": 0.75,
    "Reranker": {
      "Enabled": false,
      "BaseUrl": "",
      "Model": "BAAI/bge-reranker-v2-m3",
      "TimeoutSeconds": 15,
      "Path": "/rerank"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  }
